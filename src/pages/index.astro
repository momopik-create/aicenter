---
import { getCollection } from 'astro:content';

const products = await getCollection('products');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>AI Center - Latest Reviews</title>
    <meta name="viewport" content="width=device-width" />
    <style>
      body { font-family: system-ui, sans-serif; max-width: 800px; margin: 0 auto; padding: 2rem; background: #0f172a; color: #f8fafc; }
      h1 { color: #38bdf8; }
      .grid { display: grid; gap: 1.5rem; margin-top: 2rem; }
      .card { background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 1.5rem; }
      a { color: #38bdf8; text-decoration: none; font-weight: bold; }
    </style>
  </head>
  <body>
    <h1>AI Tools & Software Hub</h1>
    <p>Automated unbiased reviews generated daily.</p>
    
    <div class="grid">
      {products.map(product => (
        <div class="card">
          <h2>{product.data.title}</h2>
          <p>{product.data.description}</p>
          <p><strong>Rating:</strong> ⭐ {product.data.rating}</p>
        </div>
      ))}
    </div>
  </body>
</html>
